generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Perfil {
  ADMIN
  COLABORADOR
}

enum Periodicidade {
  DIARIO
  SEMANAL
}

enum StatusExecucao {
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

model Empresa {
  id        Int      @id @default(autoincrement())
  nome      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarios   Usuario[]
  checklists Checklist[]
  execucoes  ExecucaoChecklist[]

  @@index([nome])
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senhaHash String
  perfil    Perfil
  ativo     Boolean  @default(true)
  empresaId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa   Empresa             @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  execucoes ExecucaoChecklist[]

  @@index([empresaId])
  @@index([empresaId, ativo])
}

model Checklist {
  id                      Int           @id @default(autoincrement())
  titulo                  String
  periodicidade           Periodicidade
  ativo                   Boolean       @default(true)
  horarioDisponivelInicio String?
  horarioDisponivelFim    String?
  empresaId               Int
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  empresa   Empresa             @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  itens     ItemChecklist[]
  execucoes ExecucaoChecklist[]

  @@index([empresaId])
  @@index([empresaId, ativo])
  @@index([empresaId, periodicidade])
}

model ItemChecklist {
  id          Int      @id @default(autoincrement())
  descricao   String
  ordem       Int
  obrigatorio Boolean  @default(false)
  checklistId Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  checklist Checklist      @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  execucoes ExecucaoItem[]

  @@unique([checklistId, ordem])
  @@index([checklistId])
}

model ExecucaoChecklist {
  id           Int            @id @default(autoincrement())
  checklistId  Int
  usuarioId    Int
  empresaId    Int
  status       StatusExecucao @default(EM_ANDAMENTO)
  iniciadaEm   DateTime       @default(now())
  finalizadaEm DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  checklist Checklist      @relation(fields: [checklistId], references: [id], onDelete: Restrict)
  usuario   Usuario        @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  empresa   Empresa        @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  itens     ExecucaoItem[]

  @@index([empresaId])
  @@index([empresaId, status])
  @@index([usuarioId])
  @@index([checklistId])
  @@index([iniciadaEm])
}

model ExecucaoItem {
  id              Int       @id @default(autoincrement())
  execucaoId      Int
  itemChecklistId Int
  concluido       Boolean   @default(false)
  concluidoEm     DateTime?

  execucao      ExecucaoChecklist @relation(fields: [execucaoId], references: [id], onDelete: Cascade)
  itemChecklist ItemChecklist     @relation(fields: [itemChecklistId], references: [id], onDelete: Restrict)

  @@unique([execucaoId, itemChecklistId])
  @@index([execucaoId])
  @@index([itemChecklistId])
}
